# Defines the configuration of siso (next-gen build system)

import("//build/config/gclient_args.gni")

declare_args() {
  # rusty_v8 drives Ninja directly, so do not auto-detect Siso here. Besides
  # being unnecessary, the detection uses path_exists(), which is unavailable
  # in the GN version shipped by Debian 12.
  use_siso = false
}

if (use_siso) {
  siso_logs = [ "use_siso=true" ]
} else {
  siso_logs = [ "use_siso=false" ]
}
